# Copy to .env and fill in. Never commit .env.
# LiteLLM model string, for example:
#   gpt-4o-mini                    -> needs OPENAI_API_KEY
#   anthropic/claude-sonnet-4-5    -> needs ANTHROPIC_API_KEY
#   gemini/gemini-3.8-flash        -> needs GEMINI_API_KEY
#   groq/openai/gpt-oss-120b       -> needs GROQ_API_KEY
#   ollama/llama3.1                -> local model, no key, nothing leaves your PC
PANDASAI_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
